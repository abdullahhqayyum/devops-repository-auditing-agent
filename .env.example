# Copy to .env and fill in ONE provider key. Never commit .env.
# Provider: "anthropic", "openai", "gemini", "openrouter" or "ollama" (cloud providers are auto-detected from the key;
# ollama must be selected explicitly)
LLM_PROVIDER=
# Optional model override (defaults: anthropic=claude-sonnet-5-5, openai=gpt-4.1, gemini=gemini-3.6-flash,
# openrouter=openrouter/free, ollama=qwen3:8b)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# One key for many models: https://openrouter.ai/keys . Use with LLM_PROVIDER=openrouter. The agent needs a model that
# supports tool calling; free models are rate limited (documented as 20 requests/minute and 50/day on a free account).
# Pin a specific tool-capable slug in LLM_MODEL for reproducible runs; the default openrouter/free router may vary.
OPENROUTER_API_KEY=

# Optional: OpenAI-compatible endpoint (used only with LLM_PROVIDER=openai)
OPENAI_BASE_URL=
# Optional: minimum seconds between LLM requests (default 6.5 for gemini, 3.5 for openrouter, 0 otherwise)
LLM_MIN_SECONDS_BETWEEN_CALLS=

# Ollama (local, no key): LLM_PROVIDER=ollama, LLM_MODEL=<a tool-calling model you pulled>
OLLAMA_HOST=http://localhost:11434
# Context window requested per call; the agent needs at least ~16k, 32k+ recommended
OLLAMA_NUM_CTX=32768
