# Copy to .env and set your OpenRouter key. Never commit .env.
OPENROUTER_API_KEY=

# Optional OpenRouter model slug; empty defaults to openrouter/free.
# Pin a tool-capable slug for reproducible runs. Only choose a paid slug deliberately.
LLM_MODEL=

# Optional minimum seconds between model requests (default: 3.5 for the free tier).
LLM_MIN_SECONDS_BETWEEN_CALLS=
