# Copy this file to .env, then fill in OPENROUTER_API_KEY with your actual key.
# Keep this template blank; never commit .env or paste keys into reports/logs.
# Get a key from https://openrouter.ai/keys. No separate OpenAI key is needed.
# Existing shell environment variables take precedence over .env.
OPENROUTER_API_KEY=

# Optional OpenRouter model slug; empty defaults to openrouter/free.
# Pin a tool-capable slug for reproducible runs. Only choose a paid slug deliberately.
# Leave blank to keep the existing free-router default.
LLM_MODEL=

# Optional minimum seconds between model requests (default: 3.5 for the free tier).
# Leave blank unless you need a different request interval.
LLM_MIN_SECONDS_BETWEEN_CALLS=
