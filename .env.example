# Copy to .env and fill in ONE provider key. Never commit .env.
# Provider: "anthropic", "openai", "gemini" or "ollama" (cloud providers are auto-detected from the key;
# ollama must be selected explicitly)
LLM_PROVIDER=
# Optional model override (defaults: anthropic=claude-sonnet-5-5, openai=gpt-4.1, gemini=gemini-3.5-flash, ollama=qwen3:8b)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI-compatible endpoint (used only with LLM_PROVIDER=openai)
OPENAI_BASE_URL=
# Optional: minimum seconds between LLM requests (default 6.5 for gemini to fit free-tier limits, 0 otherwise)
LLM_MIN_SECONDS_BETWEEN_CALLS=

# Ollama (local, no key): LLM_PROVIDER=ollama, LLM_MODEL=<a tool-calling model you pulled>
OLLAMA_HOST=http://localhost:11434
# Context window requested per call; the agent needs at least ~16k, 32k+ recommended
OLLAMA_NUM_CTX=32768
